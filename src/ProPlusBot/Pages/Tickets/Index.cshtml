@page
@using ProPlusBot.Entities
@using ProPlusBot.Services.Subscriptions
@using ProPlusBot.Services.Tickets
@model ProPlusBot.Pages.Tickets.IndexModel
@{
    ViewData["Title"] = "تیکت‌های پشتیبانی";
}

<h2 class="mb-4">🎫 تیکت‌های پشتیبانی</h2>

@if (Model.SuccessMessage is not null)
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-auto">
        <label class="form-label">وضعیت</label>
        <select asp-for="StatusFilter" class="form-select" asp-items="Model.StatusFilterItems"></select>
    </div>
    <div class="col-auto">
        <label class="form-label">مرتب‌سازی</label>
        <select asp-for="SortOrder" class="form-select" asp-items="Model.SortOrderItems"></select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">اعمال</button>
        <a asp-page="./Index" class="btn btn-outline-secondary">پیش‌فرض</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
        <tr>
            <th>کاربر</th>
            <th>وضعیت</th>
            <th>آخرین به‌روزرسانی</th>
            <th>آخرین پاسخ</th>
            <th>پیش‌نمایش</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var t in Model.Tickets)
        {
            <tr>
                <td>
                    <div>@t.TelegramUserId</div>
                    @if (!string.IsNullOrWhiteSpace(t.Username))
                    {
                        <div class="small text-muted" dir="ltr">@@@t.Username</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(t.PhoneNumber))
                    {
                        <div class="small" dir="ltr">@t.PhoneNumber</div>
                    }
                </td>
                <td>
                    <span class="badge @TicketStatusRules.ToBadgeClass(t.Status)">@TicketStatusRules.ToDisplayName(t.Status)</span>
                </td>
                <td dir="ltr" class="small">@PersianDateTimeHelper.FormatTehranDisplay(t.UpdatedAt)</td>
                <td class="small">@(string.IsNullOrWhiteSpace(t.LastAdminDisplayName) ? "—" : t.LastAdminDisplayName)</td>
                <td class="small text-truncate" style="max-width: 280px;">@t.Preview</td>
                <td>
                    <a class="btn btn-sm btn-primary" asp-page="./Detail" asp-route-id="@t.Id">مشاهده</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (Model.Tickets.Count == 0)
{
    <p class="text-muted">تیکتی یافت نشد.</p>
}
