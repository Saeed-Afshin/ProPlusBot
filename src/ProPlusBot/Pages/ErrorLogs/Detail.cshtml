@page "{id:guid}"
@model ProPlusBot.Pages.ErrorLogs.DetailModel
@{
    ViewData["Title"] = "جزئیات خطا";
    var log = Model.ErrorLog!;
}

<h2 class="mb-4">جزئیات خطا</h2>

<p><a asp-page="/ErrorLogs/Index">بازگشت به فهرست</a></p>

<dl class="row">
    <dt class="col-sm-3">تاریخ</dt>
    <dd class="col-sm-9" dir="ltr">@PersianDateTimeHelper.FormatTehranDisplay(log.CreatedAt)</dd>

    <dt class="col-sm-3">شناسه کاربر</dt>
    <dd class="col-sm-9">@(log.TelegramUserId?.ToString() ?? "—")</dd>

    <dt class="col-sm-3">شماره</dt>
    <dd class="col-sm-9" dir="ltr">@(log.PhoneNumber ?? "—")</dd>

    <dt class="col-sm-3">عنوان</dt>
    <dd class="col-sm-9">@log.Title</dd>

    <dt class="col-sm-3">سرویس</dt>
    <dd class="col-sm-9">@ErrorLogServices.ToDisplayName(log.Service)</dd>

    <dt class="col-sm-3">منبع</dt>
    <dd class="col-sm-9">@(log.Source ?? "—")</dd>
</dl>

<div class="d-flex align-items-center justify-content-between gap-2 mt-4 mb-2">
    <h3 class="h5 mb-0">متن کامل خطا</h3>
    <button type="button" class="btn btn-sm btn-outline-secondary" id="copy-error-detail" title="کپی متن خطا" aria-label="کپی متن خطا">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1z"/>
            <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0z"/>
        </svg>
        <span class="ms-1">کپی</span>
    </button>
</div>
<pre id="error-detail-text" class="bg-white border rounded p-3 small" dir="ltr" style="white-space: pre-wrap; max-height: 70vh; overflow: auto;">@log.Detail</pre>

@section Scripts {
<script>
    (function () {
        var btn = document.getElementById('copy-error-detail');
        var pre = document.getElementById('error-detail-text');
        if (!btn || !pre) return;

        var defaultLabel = btn.innerHTML;

        btn.addEventListener('click', function () {
            var text = pre.textContent || '';
            navigator.clipboard.writeText(text).then(function () {
                btn.innerHTML = '<span>کپی شد</span>';
                setTimeout(function () { btn.innerHTML = defaultLabel; }, 2000);
            });
        });
    })();
</script>
}
