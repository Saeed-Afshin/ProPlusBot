@page
@model ProPlusBot.Pages.ErrorLogs.IndexModel
@{
    ViewData["Title"] = "گزارش خطاها";
}

<h2 class="mb-4">گزارش خطاها</h2>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead>
        <tr>
            <th>تاریخ</th>
            <th>کاربر (بله)</th>
            <th>تماس / نام</th>
            <th>سرویس</th>
            <th>عنوان خطا</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.ErrorLogs)
        {
            var usernameDisplay = string.IsNullOrWhiteSpace(item.Username)
                ? "—"
                : (item.Username.StartsWith('@') ? item.Username : "@" + item.Username);
            var displayName = string.IsNullOrWhiteSpace(item.DisplayName) ? "—" : item.DisplayName;
            <tr>
                <td dir="ltr">@PersianDateTimeHelper.FormatTehranDisplay(item.CreatedAt)</td>
                <td dir="ltr">
                    @if (item.TelegramUserId is null)
                    {
                        <div>—</div>
                        <div class="font-monospace text-muted small">—</div>
                    }
                    else
                    {
                        <div>@usernameDisplay</div>
                        <div class="font-monospace text-muted small">@item.TelegramUserId</div>
                    }
                </td>
                <td>
                    <div dir="ltr">@(item.PhoneNumber ?? "—")</div>
                    <div class="text-muted small">@displayName</div>
                </td>
                <td>@ErrorLogServices.ToDisplayName(item.Service)</td>
                <td>@item.Title</td>
                <td>
                    <a asp-page="/ErrorLogs/Detail" asp-route-id="@item.Id">جزئیات</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
