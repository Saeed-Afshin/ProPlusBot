@page
@using Microsoft.AspNetCore.Mvc.Rendering
@using ProPlusBot.Entities
@using ProPlusBot.Services.Subscriptions
@model ProPlusBot.Pages.Plans.IndexModel
@{
    ViewData["Title"] = "بسته‌ها";
}

<h2 class="mb-4">بسته‌ها و محدودیت‌ها</h2>

@if (Model.SuccessMessage is not null)
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<div class="card mb-4">
    <div class="card-header">بسته آزمایشی (Trial)</div>
    <div class="card-body">
        <form method="post" asp-page-handler="SaveTrial" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label" asp-for="PostedTrialDurationDays">مدت دوره آزمایشی (روز)</label>
                <input asp-for="PostedTrialDurationDays" class="form-control" type="number" min="1" max="365" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary">ذخیره مدت آزمایشی</button>
            </div>
        </form>
    </div>
</div>

<form method="post" asp-page-handler="SavePlans">
    <div class="card mb-3">
        <div class="card-body">
            <h3 class="h6">آپلود جایگزین ArvanCloud (مشترک)</h3>
            @if (!Model.ArvanCloudConfigured)
            {
                <div class="alert alert-warning py-2 mb-2">بخش <code>ArvanCloudStorage</code> در appsettings پیکربندی نشده است.</div>
            }
            <label class="form-label" asp-for="BaleDirectArvanMegabytes">حداکثر حجم ارسال در بله (مگابایت)</label>
            <input asp-for="BaleDirectArvanMegabytes" type="number" class="form-control" style="max-width:12rem" min="1" max="2048" />
            <div class="form-text">
                آستانه ارسال در پیام‌رسان بله (جدا از «حداکثر حجم هر فایل» بسته). فایل‌های بزرگ‌تر یا مساوی این حجم،
                برای بسته‌هایی که «حجم زیاد → Arvan» فعال است، از ArvanCloud ارسال می‌شوند؛ کوچک‌ترها مستقیم در بله.
            </div>
        </div>
    </div>
    <div class="table-responsive mb-4">
        <table class="table table-bordered table-striped align-middle text-center">
            <thead class="table-dark">
            <tr>
                <th class="text-start">تنظیم</th>
                @for (var c = 0; c < Model.PostedPlans.Count; c++)
                {
                    <th>@MediaPlatformMapper.ToDisplayName(Model.PostedPlans[c].Plan)</th>
                    <input type="hidden" name="PostedPlans[@c].Plan" value="@((int)Model.PostedPlans[c].Plan)" />
                }
            </tr>
            </thead>
            <tbody>
            <tr>
                <td class="text-start">قیمت ماهانه (تومان)</td>
                @for (var c = 0; c < Model.PostedPlans.Count; c++)
                {
                    <td><input type="number" name="PostedPlans[@c].MonthlyPriceToman" value="@Model.PostedPlans[c].MonthlyPriceToman" class="form-control form-control-sm" min="0" /></td>
                }
            </tr>
            <tr>
                <td class="text-start">تعداد دانلود ماهانه</td>
                @for (var c = 0; c < Model.PostedPlans.Count; c++)
                {
                    <td><input type="number" name="PostedPlans[@c].MonthlyDownloadCount" value="@Model.PostedPlans[c].MonthlyDownloadCount" class="form-control form-control-sm" min="0" /></td>
                }
            </tr>
            <tr>
                <td class="text-start">حجم دانلود ماهانه (مگابایت)</td>
                @for (var c = 0; c < Model.PostedPlans.Count; c++)
                {
                    <td><input type="number" name="PostedPlans[@c].MonthlyDownloadMegabytes" value="@Model.PostedPlans[c].MonthlyDownloadMegabytes" class="form-control form-control-sm" min="0" step="0.01" /></td>
                }
            </tr>
            <tr>
                <td class="text-start">جستجو ماهانه (مشترک)</td>
                @for (var c = 0; c < Model.PostedPlans.Count; c++)
                {
                    <td><input type="number" name="PostedPlans[@c].MonthlySearchCount" value="@Model.PostedPlans[c].MonthlySearchCount" class="form-control form-control-sm" min="0" /></td>
                }
            </tr>
            <tr>
                <td class="text-start">تیکت پشتیبانی (ماهانه)</td>
                @for (var c = 0; c < Model.PostedPlans.Count; c++)
                {
                    <td><input type="number" name="PostedPlans[@c].MonthlyTicketLimit" value="@Model.PostedPlans[c].MonthlyTicketLimit" class="form-control form-control-sm" min="0" /></td>
                }
            </tr>
            <tr>
                <td class="text-start">حداکثر حجم هر فایل (مگابایت)</td>
                @for (var c = 0; c < Model.PostedPlans.Count; c++)
                {
                    <td><input type="number" name="PostedPlans[@c].MaxFileMegabytes" value="@Model.PostedPlans[c].MaxFileMegabytes" class="form-control form-control-sm" min="0" step="0.01" /></td>
                }
            </tr>
            <tr class="table-secondary">
                <td class="text-start" colspan="@(Model.PostedPlans.Count + 1)"><strong>ArvanCloud (آپلود جایگزین)</strong></td>
            </tr>
            <tr>
                <td class="text-start">حجم از حد بله بیشتر → Arvan</td>
                @for (var c = 0; c < Model.PostedPlans.Count; c++)
                {
                    <td class="text-center">
                        <input asp-for="PostedPlans[c].FallbackOnSizeExceed" class="form-check-input" />
                    </td>
                }
            </tr>
            <tr>
                <td class="text-start">خطای ارسال بله → Arvan</td>
                @for (var c = 0; c < Model.PostedPlans.Count; c++)
                {
                    <td class="text-center">
                        <input asp-for="PostedPlans[c].FallbackOnBaleFailure" class="form-check-input" />
                    </td>
                }
            </tr>
            <tr>
                <td class="text-start">اعتبار لینک Arvan (ساعت)</td>
                @for (var c = 0; c < Model.PostedPlans.Count; c++)
                {
                    <td>
                        <select asp-for="PostedPlans[c].FallbackLinkExpiryHours" class="form-select form-select-sm"
                                asp-items="@(new SelectList(Model.FallbackExpiryHourOptions))"></select>
                    </td>
                }
            </tr>
            <tr class="table-secondary">
                <td class="text-start" colspan="@(Model.PostedPlans.Count + 1)"><strong>سهمیه اضافه (یک بسته: تعداد + حجم + قیمت)</strong></td>
            </tr>
            <tr>
                <td class="text-start">قیمت سهمیه اضافه (تومان)</td>
                @for (var c = 0; c < Model.PostedPlans.Count; c++)
                {
                    <td><input type="number" name="PostedPlans[@c].ExtraDownloadPackPriceToman" value="@Model.PostedPlans[c].ExtraDownloadPackPriceToman" class="form-control form-control-sm" min="0" /></td>
                }
            </tr>
            <tr>
                <td class="text-start">تعداد دانلود در بسته اضافه</td>
                @for (var c = 0; c < Model.PostedPlans.Count; c++)
                {
                    <td><input type="number" name="PostedPlans[@c].ExtraDownloadCountPack" value="@Model.PostedPlans[c].ExtraDownloadCountPack" class="form-control form-control-sm" min="0" /></td>
                }
            </tr>
            <tr>
                <td class="text-start">حجم بسته اضافه (مگابایت)</td>
                @for (var c = 0; c < Model.PostedPlans.Count; c++)
                {
                    <td><input type="number" name="PostedPlans[@c].ExtraDownloadPackMegabytes" value="@Model.PostedPlans[c].ExtraDownloadPackMegabytes" class="form-control form-control-sm" min="0" step="0.01" /></td>
                }
            </tr>
            </tbody>
        </table>
    </div>
    <button type="submit" class="btn btn-primary">ذخیره همه بسته‌ها</button>
    <a asp-page="./Index" class="btn btn-outline-secondary">لغو</a>
</form>
