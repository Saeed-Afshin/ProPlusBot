@page
@model ProPlusBot.Pages.Users.ManageModel
@{
    ViewData["Title"] = "مدیریت دستی کاربر";
}

<h2 class="mb-4">مدیریت دستی کاربر</h2>

<p class="mb-3 d-flex flex-wrap gap-2">
    <a class="btn btn-outline-secondary btn-sm" asp-page="/Users/Index">بازگشت به لیست کاربران</a>
    @if (Model.EditUserId > 0)
    {
        <form method="post" asp-page-handler="SyncFromBale" class="d-inline">
            <input type="hidden" asp-for="EditUserId" />
            <button type="submit" class="btn btn-outline-primary btn-sm">همگام‌سازی از بله</button>
        </form>
        <a class="btn btn-outline-info btn-sm" asp-page="/Messages/Index" asp-route-SingleUserId="@Model.EditUserId">ارسال پیام</a>
    }
</p>

@if (Model.SuccessMessage is not null) { <div class="alert alert-success">@Model.SuccessMessage</div> }
@if (Model.ErrorMessage is not null) { <div class="alert alert-danger">@Model.ErrorMessage</div> }

@if (Model.AccountSummary is not null)
{
    var s = Model.AccountSummary;
    var q = s.SharedQuota;
    <div class="card mb-4">
        <div class="card-header">بسته فعال و مصرف</div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-3"><strong>بسته فعال:</strong> @MediaPlatformMapper.ToDisplayName(s.EffectivePlan)</div>
                @if (s.StoredPlan != s.EffectivePlan)
                {
                    <div class="col-md-3"><strong>بسته ثبت‌شده:</strong> @MediaPlatformMapper.ToDisplayName(s.StoredPlan)</div>
                }
                <div class="col-md-3">
                    <strong>انقضا:</strong>
                    @if (s.PlanExpiresAt is null)
                    {
                        <span>—</span>
                    }
                    else
                    {
                        <span dir="ltr">@PersianDateTimeHelper.ToShamsiDateString(s.PlanExpiresAt) @PersianDateTimeHelper.ToTimeString(s.PlanExpiresAt)</span>
                    }
                </div>
                <div class="col-md-3"><strong>وضعیت:</strong> @(s.IsBanned ? "مسدود" : "فعال")</div>
            </div>
            <p class="text-muted small mb-3">
                سهمیه ماهانه بین یوتیوب و پینترست مشترک است. اعداد به صورت <strong>مصرف / سقف</strong>.
            </p>
            <div class="table-responsive mb-3">
                <table class="table table-sm table-bordered align-middle text-center mb-0">
                    <thead class="table-light">
                    <tr>
                        <th>دانلود ماهانه</th>
                        <th>حجم ماهانه</th>
                        <th>جستجو ماهانه</th>
                        <th>سهمیه اضافه</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td dir="ltr">@q.MonthlyDownloadCountUsed / @q.MonthlyDownloadCountLimit</td>
                        <td dir="ltr">@ByteUnits.FormatVolume(q.MonthlyBytesUsed) / @ByteUnits.FormatVolume(q.MonthlyBytesLimit)</td>
                        <td dir="ltr">@q.MonthlySearchUsed / @q.MonthlySearchLimit</td>
                        <td dir="ltr">
                            @if (q.ExtraDownloadCountBonus > 0 || q.ExtraDownloadBytesBonus > 0 || q.ExtraSearchCountBonus > 0)
                            {
                                <span>+@q.ExtraDownloadCountBonus دانلود، +@ByteUnits.FormatVolume(q.ExtraDownloadBytesBonus)، +@q.ExtraSearchCountBonus جستجو</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle text-center mb-0">
                    <thead class="table-light">
                    <tr>
                        <th>پلتفرم</th>
                        <th>حداکثر فایل</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var pf in s.PlatformMaxFiles)
                    {
                        <tr>
                            <td>@MediaPlatformMapper.ToDisplayName(pf.Platform)</td>
                            <td dir="ltr">@ByteUnits.FormatVolume(pf.MaxFileBytesLimit)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (Model.ReservedPlans.Count > 0)
    {
        <div class="card mb-4">
            <div class="card-header">بسته‌های رزرو</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead><tr><th>بسته</th><th>مدت (روز)</th><th>تاریخ رزرو</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var r in Model.ReservedPlans)
                    {
                        <tr>
                            <td>@MediaPlatformMapper.ToDisplayName(r.Plan)</td>
                            <td>@r.DurationDays</td>
                            <td dir="ltr">@PersianDateTimeHelper.FormatTehranDisplay(r.CreatedAt)</td>
                            <td>
                                <form method="post" asp-page-handler="DeleteReserved" class="d-inline">
                                    <input type="hidden" name="reservationId" value="@r.Id" />
                                    <input type="hidden" name="EditUserId" value="@Model.EditUserId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (Model.UserLimitRows.Count > 0)
    {
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>حداکثر حجم فایل (اختصاصی کاربر)</span>
                <form method="post" asp-page-handler="ClearUserLimits" class="m-0">
                    <input type="hidden" asp-for="EditUserId" />
                    <button type="submit" class="btn btn-sm btn-outline-warning">بازگشت به پیش‌فرض بسته</button>
                </form>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle text-center mb-0">
                        <thead class="table-light">
                        <tr>
                            <th>حداکثر حجم هر فایل (مگابایت)</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.UserLimitRows)
                        {
                            var rowFormId = $"limit-{Model.EditUserId}";
                            <tr class="@(row.IsCustom ? "table-warning" : null)">
                                <td>
                                    <input form="@rowFormId" type="number" name="megabytes" value="@row.MaxFileMegabytes"
                                           class="form-control form-control-sm" min="0" step="0.01" dir="ltr" />
                                </td>
                                <td>
                                    <button type="submit" form="@rowFormId" class="btn btn-sm btn-primary">ذخیره</button>
                                </td>
                            </tr>
                            <form id="@rowFormId" method="post" asp-page-handler="SaveUserMaxFile" class="d-none">
                                <input type="hidden" name="EditUserId" value="@Model.EditUserId" />
                            </form>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

<div class="card">
    <div class="card-body">
        <form method="post" asp-page-handler="SetPlan" class="row g-3 mb-4">
            <div class="col-md-3">
                <label class="form-label">شناسه کاربر</label>
                <input asp-for="EditUserId" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">بسته</label>
                <select asp-for="EditPlan" class="form-select" asp-items="MediaPlatformMapper.GetPlanSelectList(Model.EditPlan)"></select>
            </div>
            <div class="col-md-3">
                <label class="form-label">تاریخ انقضا (شمسی، اختیاری)</label>
                <input asp-for="EditExpiresDateShamsi" class="form-control" dir="ltr" placeholder="1404/01/01" autocomplete="off" inputmode="numeric" />
            </div>
            <div class="col-md-2">
                <label class="form-label">ساعت انقضا (۲۴ ساعته)</label>
                <input asp-for="EditExpiresTime" class="form-control font-monospace" dir="ltr" type="text" placeholder="00:00:00" maxlength="8" autocomplete="off" inputmode="numeric" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">تعیین بسته</button>
            </div>
        </form>

        <form method="post" asp-page-handler="Extend" class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label">شناسه کاربر</label>
                <input asp-for="EditUserId" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">تمدید (روز)</label>
                <input asp-for="ExtendDays" class="form-control" type="number" min="1" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-secondary w-100">تمدید اشتراک</button>
            </div>
        </form>

        <form method="post" asp-page-handler="AdjustQuota" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">شناسه کاربر</label>
                <input asp-for="EditUserId" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Δ تعداد دانلود اضافه</label>
                <input asp-for="QuotaCountDelta" class="form-control" type="number" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Δ حجم اضافه (مگابایت)</label>
                <input asp-for="QuotaMegabytesDelta" class="form-control" type="number" step="0.01" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-outline-primary w-100">تنظیم سهمیه</button>
            </div>
        </form>
    </div>
</div>
