@page
@model ProPlusBot.Pages.Chats.UserModel
@{
    ViewData["Title"] = "گفتگوی کاربر";
    var u = Model.ChatUser!;
    var displayName = !string.IsNullOrWhiteSpace(u.Username)
        ? "@" + u.Username
        : string.Join(" ", new[] { u.FirstName, u.LastName }.Where(s => !string.IsNullOrWhiteSpace(s)));
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Chats/Index">گفتگوها</a></li>
        <li class="breadcrumb-item active" aria-current="page">@u.TelegramUserId</li>
    </ol>
</nav>

<h2 class="mb-2">گفتگوی کاربر</h2>
<p class="text-muted mb-4">
    شناسه: <span dir="ltr">@u.TelegramUserId</span>
    · @(string.IsNullOrWhiteSpace(displayName) ? "—" : displayName)
    · شماره: <span dir="ltr">@(u.PhoneNumber ?? "—")</span>
    · @u.MessageCount پیام
</p>

<div class="table-responsive">
    <table class="table table-bordered align-middle">
        <thead>
        <tr>
            <th>زمان (تهران)</th>
            <th>جهت</th>
            <th>نوع</th>
            <th>متن</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var m in Model.Messages)
        {
            <tr class="@(m.Direction == MessageDirection.Incoming ? "table-light" : "")">
                <td dir="ltr" class="text-nowrap small">@PersianDateTimeHelper.FormatTehranDisplay(m.CreatedAt)</td>
                <td>@(m.Direction == MessageDirection.Incoming ? "ورودی" : "خروجی")</td>
                <td class="small">@m.MessageType</td>
                <td class="font-monospace small" style="white-space: pre-wrap; word-break: break-word;">@(m.Text ?? "—")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            @if (Model.PageNumber > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="/Chats/User" asp-route-userId="@Model.UserId" asp-route-page="@(Model.PageNumber - 1)">قبلی</a>
                </li>
            }
            <li class="page-item disabled">
                <span class="page-link">صفحه @Model.PageNumber از @Model.TotalPages</span>
            </li>
            @if (Model.PageNumber < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="/Chats/User" asp-route-userId="@Model.UserId" asp-route-page="@(Model.PageNumber + 1)">بعدی</a>
                </li>
            }
        </ul>
    </nav>
}
