@page
@model ProPlusBot.Pages.Payments.IndexModel
@{
    ViewData["Title"] = "پرداخت‌ها";
}

<h2 class="mb-4">تاریخچه پرداخت‌ها</h2>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead>
        <tr>
            <th>تاریخ</th>
            <th>کاربر (بله)</th>
            <th>تماس / نام</th>
            <th>نوع</th>
            <th>مبلغ (تومان)</th>
            <th>وضعیت</th>
            <th>از بسته</th>
            <th>به بسته</th>
            <th>پلتفرم</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var p in Model.Payments)
        {
            var usernameDisplay = string.IsNullOrWhiteSpace(p.Username)
                ? "—"
                : (p.Username.StartsWith('@') ? p.Username : "@" + p.Username);
            var displayName = string.IsNullOrWhiteSpace(p.DisplayName) ? "—" : p.DisplayName;
            <tr>
                <td dir="ltr">@PersianDateTimeHelper.FormatTehranDisplay(p.CreatedAt)</td>
                <td dir="ltr">
                    <div>@usernameDisplay</div>
                    <div class="font-monospace text-muted small">@p.TelegramUserId</div>
                </td>
                <td>
                    <div dir="ltr">@(p.PhoneNumber ?? "—")</div>
                    <div class="text-muted small">@displayName</div>
                </td>
                <td>@(p.Type == PaymentType.PlanUpgrade ? "ارتقای بسته" : p.Type == PaymentType.PlanPurchase ? "خرید بسته" : "سهمیه اضافه")</td>
                <td>@p.AmountToman.ToString("N0")</td>
                <td>@(p.Status switch { PaymentStatus.Pending => "در انتظار", PaymentStatus.Completed => "موفق", PaymentStatus.Failed => "ناموفق", PaymentStatus.Cancelled => "لغو", _ => p.Status.ToString() })</td>
                <td>@(p.FromPlan is null ? "—" : MediaPlatformMapper.ToDisplayName(p.FromPlan.Value))</td>
                <td>@(p.ToPlan is null ? "—" : MediaPlatformMapper.ToDisplayName(p.ToPlan.Value))</td>
                <td>@(p.Platform is null ? "—" : MediaPlatformMapper.ToDisplayName(p.Platform.Value))</td>
            </tr>
        }
        </tbody>
    </table>
</div>
