# Copy to .env and fill in secrets before: docker compose up -d

# PostgreSQL (db service)
POSTGRES_USER=proplus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=proplusbot
POSTGRES_PORT=5432

# Redis (redis service)
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# App
APP_HTTP_PORT=8080
Bot__Token=
Jwt__Secret=

# Redis (app → redis service hostname; must match REDIS_PASSWORD)
Redis__ConnectionString=redis:6379,password=change-me,defaultDatabase=0
Redis__InstanceName=ProPlusBot:
